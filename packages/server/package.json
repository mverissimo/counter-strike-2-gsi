{
  "name": "@counter-strike-2-gsi/server",
  "version": "0.3.0",
  "description": "Transport-agnostic core for validating, merging, and dispatching Counter-Strike 2 GSI payloads.",
  "homepage": "https://github.com/mverissimo/counter-strike-2-gsi#readme",
  "bugs": {
    "url": "https://github.com/mverissimo/counter-strike-2-gsi/issues"
  },
  "license": "MIT",
  "author": "Matheus Verissimo <mverissimu@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mverissimo/counter-strike-2-gsi.git",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@counter-strike-2-gsi/types": "workspace:*",
    "@fastify/deepmerge": "catalog:",
    "fast-deep-equal": "catalog:",
    "microdiff": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "arktype": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "inlinedDependencies": {
    "@ark/schema": "0.56.8",
    "@ark/util": "0.56.8",
    "arkregex": "0.0.14",
    "arktype": "2.2.9"
  }
}
