# Copy to `.env` and edit. Every value here is the built-in default, so the
# app runs with this file absent — set a value only to change it.

# Port the GSI server listens on. Vite's dev proxy reads this too, so the two
# stay in step — but the CS2 cfg's "uri" is a separate file and does not.
PORT=3000

# Proxy target for /gsi and /sse in development. Defaults to the PORT above on
# localhost; set this only to develop against a GSI server on another machine.
# GSI_SERVER_URL=http://localhost:3000

# Point the browser at a GSI server somewhere else. Defaults to the page's own
# origin, which Vite proxies to PORT above. Use ws:// or wss:// to switch the
# transport from SSE to WebSocket.
# VITE_GSI_URL=http://localhost:3000/sse
